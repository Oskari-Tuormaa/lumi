/*
 * HUB75E panel on the ESP32-S3 LCD_CAM peripheral (i80, 16 bit).
 *
 * All 14 HUB75 signals are generated by LCD_CAM: CLK is the LCD pixel clock,
 * everything else is a bit of the 16 bit data word.
 *
 *   D0  R1   GPIO1      D8   A    GPIO8
 *   D1  G1   GPIO2      D9   B    GPIO9
 *   D2  B1   GPIO3      D10  C    GPIO10
 *   D3  R2   GPIO4      D11  D    GPIO11
 *   D4  G2   GPIO5      D12  E    GPIO7
 *   D5  B2   GPIO6      PCLK CLK  GPIO12
 *   D6  LAT  GPIO13
 *   D7  OE   GPIO14
 *
 * The bit assignment is fixed in src/hub75_lcd.cpp; only the GPIOs can be
 * changed here.
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-gpio-sigmap.h>

&pinctrl {
    hub75_lcd_default: hub75_lcd_default {
        group1 {
            pinmux = <LCD_CAM_DATA_OUT0_GPIO1>,
                     <LCD_CAM_DATA_OUT1_GPIO2>,
                     <LCD_CAM_DATA_OUT2_GPIO3>,
                     <LCD_CAM_DATA_OUT3_GPIO4>,
                     <LCD_CAM_DATA_OUT4_GPIO5>,
                     <LCD_CAM_DATA_OUT5_GPIO6>,
                     <LCD_CAM_DATA_OUT6_GPIO13>,
                     <LCD_CAM_DATA_OUT7_GPIO14>,
                     <LCD_CAM_DATA_OUT8_GPIO8>,
                     <LCD_CAM_DATA_OUT9_GPIO9>,
                     <LCD_CAM_DATA_OUT10_GPIO10>,
                     <LCD_CAM_DATA_OUT11_GPIO11>,
                     <LCD_CAM_DATA_OUT12_GPIO7>,
                     <LCD_CAM_LCD_CLK_GPIO12>;
            output-enable;
        };
    };
};

&lcd_cam {
    status = "okay";
    pinctrl-0 = <&hub75_lcd_default>;
    pinctrl-names = "default";
};

&dma {
    status = "okay";
};
